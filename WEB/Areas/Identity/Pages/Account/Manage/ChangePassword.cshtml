@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}
<div class="animate__animated animate__fadeIn">
    @* Başlık Alanı *@
    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">
            <i class="fas fa-lock text-primary me-2" style="color: #3b82f6;"></i>
            Şifre Değiştir
        </h3>
        <p class="text-muted small mb-0">Hesap güvenliğiniz için güçlü ve benzersiz bir şifre belirleyin.</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="row" >
        <div class="col-md-12 col-lg-8">
            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                @* Mevcut Şifre *@
                <div class="form-floating mb-3">
                    <input asp-for="Input.OldPassword" class="form-control rounded-3" autocomplete="current-password" aria-required="true" placeholder="Mevcut Şifre" />
                    <label asp-for="Input.OldPassword"><i class="fas fa-unlock me-2 text-muted"></i>Mevcut Şifreniz</label>
                    <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                </div>

                @* Yeni Şifre *@
                <div class="form-floating mb-3">
                    <input asp-for="Input.NewPassword" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="Yeni Şifre" />
                    <label asp-for="Input.NewPassword"><i class="fas fa-key me-2 text-muted"></i>Yeni Şifre</label>
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>

                @* Yeni Şifre Tekrar *@
                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="Yeni Şifre Tekrar" />
                    <label asp-for="Input.ConfirmPassword"><i class="fas fa-key me-2 text-muted"></i>Yeni Şifre Tekrar</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                @* Güncelleme Butonu *@
                <button type="submit" class="w-100 btn btn-primary btn-lg py-3 rounded-pill fw-bold shadow-sm" style="background-color: #0f172a; border: none;">
                    <i class="fas fa-sync-alt me-2"></i>Şifreyi Güncelle
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}