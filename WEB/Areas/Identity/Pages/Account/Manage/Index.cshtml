@page
@model IndexModel
@{
    ViewData["Title"] = "Profil Bilgileri";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 animate__animated animate__fadeIn">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                
                @* Profil Üst Banner/Avatar Alanı *@
                <div class="card-header text-white text-center py-5 border-0 position-relative" style="background-color: #0f172a !important;">
                    <div class="mb-3 d-inline-block position-relative">
                        <div class="rounded-circle bg-accent text-white d-flex align-items-center justify-content-center shadow" style="width: 90px; height: 90px; font-size: 2.5rem; background-color: #3b82f6;">
                            <i class="fas fa-user-astronaut"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark">Hesap Profili</h3>
                    <p class="text-light-muted small mb-0">Sistemdeki üyelik bilgilerinizi buradan yönetebilirsiniz</p>
                </div>

                @* Profil Form İçeriği *@
                <div class="card-body p-4 p-sm-5 bg-white">
                    <partial name="_StatusMessage" for="StatusMessage" />
                    
                    <form id="profile-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                        @* Kullanıcı Adı (Değiştirilemez - Readonly) *@
                        <div class="form-floating mb-3">
                            <input asp-for="Username" class="form-control rounded-3 bg-light" placeholder="Kullanıcı Adı" disabled />
                            <label asp-for="Username"><i class="fas fa-user me-2 text-muted"></i>Kullanıcı Adı / E-posta</label>
                        </div>

                        @* Telefon Numarası (Opsiyonel Güncellenebilir) *@
                        <div class="form-floating mb-4">
                            <input asp-for="Input.PhoneNumber" class="form-control rounded-3" placeholder="Telefon Numarası" />
                            <label asp-for="Input.PhoneNumber"><i class="fas fa-phone me-2 text-muted"></i>Telefon Numarası</label>
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>

                        @* Değişiklikleri Kaydet Butonu *@
                        <button id="update-profile-button" type="submit" class="w-100 btn btn-primary btn-lg py-3 rounded-pill fw-bold shadow-sm" style="background-color: #0f172a; border: none;">
                            <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                        </button>
                    </form>

                    @* Ek Güvenlik / Şifre Değiştirme Linki *@
                    <div class="text-center mt-4 border-top pt-3">
                        <p class="text-muted small mb-0">
                            Güvenlik ayarları veya şifre işlemleri için 
                            <a href="/Identity/Account/Manage/ChangePassword" class="text-primary fw-bold text-decoration-none">Şifre Değiştir</a>
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}