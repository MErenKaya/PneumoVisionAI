@page
@model LoginModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 animate__animated animate__fadeInUp">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                @* Kart Başlığı *@
                <div class="card-header bg-primary text-white text-center py-4 border-0" style="background-color: #0f172a !important;">
                    <h3 class="fw-bold mb-0"><i class="fas fa-sign-in-alt me-2 text-accent"></i>Sisteme Giriş</h3>
                    <p class="text-light-muted small mb-0 mt-2">Hoş geldiniz, bilgilerinizi giriniz</p>
                </div>

                @* Kart İçeriği *@
                <div class="card-body p-4 p-sm-5 bg-white">
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>
                        
                        @* E-posta *@
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email"><i class="fas fa-envelope me-2 text-muted"></i>E-posta Adresi</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        
                        @* Şifre *@
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password"><i class="fas fa-lock me-2 text-muted"></i>Şifre</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        
                        @* Beni Hatırla *@
                        <div class="checkbox mb-4 d-flex justify-content-between align-items-center">
                            <label asp-for="Input.RememberMe" class="form-label small text-muted mb-0">
                                <input class="form-check-input me-1" asp-for="Input.RememberMe" />
                                Beni Hatırla
                            </label>
                        </div>
                        
                        @* Giriş Butonu *@
                        <button id="login-submit" type="submit" class="w-100 btn btn-accent btn-lg py-3 rounded-pill fw-bold shadow-sm mb-3">
                            Giriş Yap
                        </button>
                    </form>

                    <div class="text-center mt-4 border-top pt-3">
                        <p class="text-muted small mb-0">
                            Hesabınız yok mu? 
                            <a href="/Identity/Account/Register" class="text-accent fw-bold text-decoration-none">Yeni Hesap Oluştur</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}